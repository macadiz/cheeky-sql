{
  "name": "cheeky-sql",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@devexpress/dx-react-core": "^3.0.2",
    "@devexpress/dx-react-grid": "^3.0.2",
    "@devexpress/dx-react-grid-material-ui": "^3.0.2",
    "@emotion/react": "^11.8.2",
    "@emotion/styled": "^11.8.1",
    "@mui/icons-material": "^5.5.1",
    "@mui/material": "^5.5.1",
    "@mui/styles": "^5.5.1",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.42",
    "@types/react-dom": "^18.2.17",
    "cross-env": "^7.0.3",
    "mysql": "^2.18.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.0.2",
    "typescript": "^5.3.3",
    "util": "^0.12.5",
    "uuid": "^8.3.2",
    "web-vitals": "^3.5.0"
  },
  "_electron_dependencies_comment": "Temporarily removed for React/Vite migration: @electron/remote, electron-is-dev, electron-squirrel-startup, mysql, util",
  "main": "public/electron.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none npm run dev\" \"npm:electron\"",
    "electron": "wait-on tcp:3000 && electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "devDependencies": {
    "@types/mysql": "^2.15.27",
    "@types/uuid": "^8.3.4",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.55.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-import": "^2.25.4",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "vite": "^5.0.7"
  },
  "_electron_devDependencies_comment": "Temporarily removed for React/Vite migration: @electron-forge/*, electron, concurrently, wait-on, @types/mysql",
  "config": {
    "forge": {
      "packagerConfig": {},
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "cheeky_sql"
          }
        },
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "darwin"
          ]
        },
        {
          "name": "@electron-forge/maker-deb",
          "config": {}
        },
        {
          "name": "@electron-forge/maker-rpm",
          "config": {}
        }
      ]
    }
  }
}
